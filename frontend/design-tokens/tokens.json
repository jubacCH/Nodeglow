{
  "_comment": [
    "Single source of truth for the Nodeglow design system (concept E3 'Nodeglow', accent Glow Violet).",
    "Run `npm run build:tokens` to regenerate src/styles/tokens.gen.{css,ts}; never edit the generated files.",
    "Every key becomes a CSS custom property `--ng-<key>`. `{name}` inside a value is a reference and is",
    "emitted as `var(--ng-name)`. `theme.dark` is the default (:root); `theme.light` applies to",
    "html[data-theme=light]. `shared` holds theme-independent and derived tokens",
    "(reference: docs/design/04-design-system.md).",
    "`contrast` lists the text/background pairs that `npm run check:contrast` and the vitest suite verify."
  ],

  "theme": {
    "dark": {
      "color-scheme": "dark",

      "bg":        "#101217",
      "rail":      "#0C0E12",
      "surface":   "#181A20",
      "surface-2": "#1F222A",
      "surface-3": "#282B34",
      "border":    "rgba(255, 255, 255, 0.06)",
      "border-2":  "rgba(255, 255, 255, 0.11)",
      "line":      "#363A45",
      "hover":     "rgba(255, 255, 255, 0.04)",

      "text":   "#ECEEF2",
      "text-2": "#A2A6B1",
      "text-3": "#8A8F9B",

      "accent":           "#7C6CFF",
      "accent-text":      "#9488FF",
      "accent-hover":     "#8F81FF",
      "accent-btn":       "#6656F2",
      "accent-btn-hover": "#5A4AE6",
      "on-accent":        "#FFFFFF",
      "focus":            "#9488FF",
      "soft-pct":         "16%",
      "fill-pct":         "18%",

      "st-ok":       "#3CC37A",
      "st-degraded": "#E7C04C",
      "st-warning":  "#F2923C",
      "st-down":     "#F2545B",
      "st-maint":    "#8F97A8",
      "st-unknown":  "#565B66",
      "hatch-2":     "#252830",

      "st-ok-text":       "{st-ok}",
      "st-degraded-text": "{st-degraded}",
      "st-warning-text":  "{st-warning}",
      "st-down-text":     "#F46A70",
      "st-maint-text":    "#A3AABA",
      "st-unknown-text":  "{text-2}",

      "grid":     "rgba(255, 255, 255, 0.05)",
      "scrim":    "rgba(4, 5, 8, 0.6)",
      "shadow":   "0 16px 48px rgba(0, 0, 0, 0.55), 0 1px 0 rgba(255, 255, 255, 0.03) inset",
      "shadow-sm": "0 1px 2px rgba(0, 0, 0, 0.4)",
      "tip-bg":   "#262932",
      "tip-text": "#ECEEF2",

      "_chart": "Categorical series colours. Hues stay clear of the status hues (green, yellow, orange, red) and of petrol/cyan.",
      "chart-1": "{accent}",
      "chart-2": "#5AA9F0",
      "chart-3": "#E37BD0",
      "chart-4": "#A7ACB8",
      "chart-5": "#B9AEFF",
      "chart-6": "#3F7FD1",

      "glow-crit":     "0 0 0 1px color-mix(in srgb, {st-down} 34%, transparent), 0 0 24px 2px color-mix(in srgb, {st-down} 30%, transparent)",
      "glow-warn":     "0 0 0 1px color-mix(in srgb, {st-warning} 18%, transparent), 0 0 14px 0 color-mix(in srgb, {st-warning} 16%, transparent)",
      "glow-dot-crit": "0 0 0 3px color-mix(in srgb, {st-down} 16%, transparent), 0 0 10px 1px color-mix(in srgb, {st-down} 55%, transparent)",
      "glow-dot-warn": "0 0 7px 0 color-mix(in srgb, {st-warning} 42%, transparent)",
      "wire-glow":     "drop-shadow(0 0 3px color-mix(in srgb, {st-down} 65%, transparent))",
      "branch-glow":   "-4px 0 10px -6px color-mix(in srgb, {st-down} 70%, transparent)",
      "ring-core":     "color-mix(in srgb, color-mix(in srgb, {st-down} 72%, {st-warning}) 26%, transparent)",
      "ring-core-warn": "color-mix(in srgb, {st-warning} 20%, transparent)",
      "accent-glow":   "0 0 0 1px color-mix(in srgb, {accent} 45%, transparent), 0 0 18px 0 color-mix(in srgb, {accent} 36%, transparent)",
      "mark-halo":     "0.55",
      "wm-glow":       "0 0 14px color-mix(in srgb, {accent} 45%, transparent)",
      "breathe":       "ng-breathe 6s ease-in-out infinite"
    },

    "light": {
      "color-scheme": "light",

      "bg":        "#F4F5F8",
      "rail":      "#FFFFFF",
      "surface":   "#FFFFFF",
      "surface-2": "#F2F3F6",
      "surface-3": "#E8EAEF",
      "border":    "#E3E5EA",
      "border-2":  "#D6D9E0",
      "line":      "#C9CED7",
      "hover":     "rgba(20, 24, 32, 0.035)",

      "text":   "#191B21",
      "text-2": "#5A5E69",
      "text-3": "#666B76",

      "accent":           "#5B4BE0",
      "accent-text":      "#5242D6",
      "accent-hover":     "#4C3CD2",
      "accent-btn":       "#5B4BE0",
      "accent-btn-hover": "#4C3CD2",
      "on-accent":        "#FFFFFF",
      "focus":            "#5B4BE0",
      "soft-pct":         "10%",
      "fill-pct":         "12%",

      "st-ok":       "#1E9E57",
      "st-degraded": "#B98A00",
      "st-warning":  "#DD6B12",
      "st-down":     "#DC3540",
      "st-maint":    "#6F7788",
      "st-unknown":  "#A4A8B0",
      "hatch-2":     "#E3E5E9",

      "st-ok-text":       "#167A43",
      "st-degraded-text": "#806000",
      "st-warning-text":  "#AE520B",
      "st-down-text":     "#C42A35",
      "st-maint-text":    "#5A6170",
      "st-unknown-text":  "{text-2}",

      "grid":     "#EEF0F3",
      "scrim":    "rgba(20, 22, 28, 0.28)",
      "shadow":   "0 16px 48px rgba(20, 24, 32, 0.16), 0 1px 3px rgba(20, 24, 32, 0.06)",
      "shadow-sm": "0 1px 2px rgba(20, 24, 32, 0.06)",
      "tip-bg":   "#1D1F25",
      "tip-text": "#F2F3F5",

      "_chart": "Categorical series colours (light).",
      "chart-1": "{accent}",
      "chart-2": "#2F7FD0",
      "chart-3": "#B8409F",
      "chart-4": "#737885",
      "chart-5": "#8C7BF0",
      "chart-6": "#1F5FAF",

      "glow-crit":     "0 0 0 1px color-mix(in srgb, {st-down} 26%, transparent), 0 6px 16px -6px color-mix(in srgb, {st-down} 34%, transparent)",
      "glow-warn":     "0 4px 12px -6px color-mix(in srgb, {st-warning} 30%, transparent)",
      "glow-dot-crit": "0 0 0 3px color-mix(in srgb, {st-down} 15%, transparent)",
      "glow-dot-warn": "0 0 0 3px color-mix(in srgb, {st-warning} 12%, transparent)",
      "wire-glow":     "none",
      "branch-glow":   "none",
      "ring-core":     "color-mix(in srgb, {st-down} 6%, transparent)",
      "ring-core-warn": "color-mix(in srgb, {st-warning} 6%, transparent)",
      "accent-glow":   "0 0 0 3px color-mix(in srgb, {accent} 20%, transparent)",
      "mark-halo":     "0.28",
      "wm-glow":       "none",
      "breathe":       "none"
    }
  },

  "shared": {
    "accent-soft":    "color-mix(in srgb, {accent} {soft-pct}, transparent)",
    "chart-fill":     "color-mix(in srgb, {accent} {fill-pct}, transparent)",
    "st-ok-soft":       "color-mix(in srgb, {st-ok} 13%, transparent)",
    "st-degraded-soft": "color-mix(in srgb, {st-degraded} 13%, transparent)",
    "st-warning-soft":  "color-mix(in srgb, {st-warning} 13%, transparent)",
    "st-down-soft":     "color-mix(in srgb, {st-down} 13%, transparent)",
    "st-maint-soft":    "color-mix(in srgb, {st-maint} 15%, transparent)",
    "st-unknown-soft":  "color-mix(in srgb, {st-unknown} 20%, transparent)",
    "hatch": "repeating-linear-gradient(135deg, {st-unknown} 0 2px, transparent 2px 5px)",

    "radius":      "10px",
    "radius-sm":   "7px",
    "radius-ctl":  "8px",
    "radius-chip": "5px",
    "radius-lg":   "12px",
    "radius-pill": "9999px",

    "font-ui":      "var(--font-inter-tight), \"Inter Tight\", \"SF Pro Text\", \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, -apple-system, sans-serif",
    "font-display": "var(--font-sora), \"Sora\", var(--font-inter-tight), \"Segoe UI Variable Display\", \"Segoe UI\", system-ui, sans-serif",
    "font-mono":    "var(--font-jetbrains-mono), \"JetBrains Mono\", ui-monospace, \"SF Mono\", \"Cascadia Mono\", Consolas, monospace",

    "_fs": "Type scale in rem; the root font size is the user preference (default 14px), so 1rem = 14px.",
    "fs-micro":  "0.7857rem",
    "fs-meta":   "0.8571rem",
    "fs-ui":     "0.9286rem",
    "fs-body":   "1rem",
    "fs-lead":   "1.2143rem",
    "fs-h3":     "1.4286rem",
    "fs-h1":     "1.7143rem",
    "fs-num-sm": "2rem",
    "fs-num":    "2.5714rem",
    "fs-num-lg": "2.8571rem",

    "rail-w":      "60px",
    "topbar-h":    "60px",
    "tabbar-h":    "58px",
    "content-max": "1760px",
    "gutter":      "24px",
    "gutter-sm":   "16px",
    "gap":         "16px",

    "ease-out":   "cubic-bezier(0.2, 0.7, 0.2, 1)",
    "dur-fast":   "120ms",
    "dur":        "150ms",
    "dur-panel":  "220ms",

    "z-topbar":  "20",
    "z-rail":    "30",
    "z-popover": "65",
    "z-scrim":   "60",
    "z-panel":   "70",
    "z-palette": "75",
    "z-tooltip": "80",
    "z-toast":   "90"
  },

  "contrast": {
    "_comment": "[foreground, background, minimum ratio]. 4.5 = WCAG AA body text, 3 = large text / UI graphics.",
    "pairs": [
      ["text",   "bg", 4.5], ["text",   "surface", 4.5], ["text",   "surface-2", 4.5], ["text", "surface-3", 4.5],
      ["text-2", "bg", 4.5], ["text-2", "surface", 4.5], ["text-2", "surface-2", 4.5],
      ["text-3", "bg", 4.5], ["text-3", "surface", 4.5], ["text-3", "surface-2", 4.5],
      ["accent-text", "bg", 4.5], ["accent-text", "surface", 4.5],
      ["on-accent", "accent-btn", 4.5], ["on-accent", "accent-btn-hover", 4.5],
      ["tip-text", "tip-bg", 4.5],
      ["st-ok-text", "surface", 4.5], ["st-degraded-text", "surface", 4.5], ["st-warning-text", "surface", 4.5],
      ["st-down-text", "surface", 4.5], ["st-maint-text", "surface", 4.5], ["st-unknown-text", "surface", 4.5],
      ["st-ok-text", "st-ok-soft", 4.5], ["st-degraded-text", "st-degraded-soft", 4.5],
      ["st-warning-text", "st-warning-soft", 4.5], ["st-down-text", "st-down-soft", 4.5],
      ["st-maint-text", "st-maint-soft", 4.5], ["st-unknown-text", "st-unknown-soft", 4.5],
      ["accent-text", "accent-soft", 4.5],
      ["st-ok", "surface", 3], ["st-degraded", "surface", 3], ["st-warning", "surface", 3],
      ["st-down", "surface", 3], ["st-maint", "surface", 3],
      ["focus", "bg", 3], ["focus", "surface", 3]
    ]
  }
}
