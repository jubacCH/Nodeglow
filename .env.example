# Nodeglow environment configuration (git checkout / docker-compose.yml)
# Copy to .env and adjust values. Release installs get their .env from
# install.sh instead. Every variable: docs/OPERATIONS.md "Configuration reference".

# PostgreSQL (used by docker compose)
POSTGRES_DB=nodeglow
POSTGRES_USER=nodeglow
POSTGRES_PASSWORD=changeme

# App database URL. docker compose builds it from the POSTGRES_* values above
# and ignores this line; it only matters when running the backend outside
# compose (without it the backend falls back to SQLite in DATA_DIR, which is
# not meant for real installations).
DATABASE_URL=postgresql+asyncpg://nodeglow:${POSTGRES_PASSWORD}@db:5432/nodeglow

# Secret key for Fernet credential encryption + HMAC pepper.
# Recommended: generate once with `openssl rand -hex 32` and set it here so
# the key lives OUTSIDE the data volume. If left empty the backend
# auto-generates one inside /data/.secret_key and logs a warning.
#
# Migrating an EXISTING deployment from file-based key to env-based key:
#   1. Stop the backend container
#   2. Read the current file value:  docker compose run --rm nodeglow cat /data/.secret_key
#   3. Paste it verbatim into SECRET_KEY below (value must be IDENTICAL —
#      setting a different SECRET_KEY will render all existing encrypted
#      credentials unreadable)
#   4. Start the backend, verify it logs no warning about volume-loaded keys
#   5. Delete /data/.secret_key from the volume
# SECRET_KEY=

# Data directory (for SQLite DB + secret key file)
# DATA_DIR=/data

# Legacy escape hatch for the pre-install-token agent enrollment flow.
# Set to "1" ONLY if you still have existing agents that re-enroll using the
# shared agent_enrollment_key. Leave unset on fresh deployments — new agents
# must use per-install tokens minted via POST /api/agents/install-tokens.
# NODEGLOW_ALLOW_SHARED_ENROLLMENT=

# Shared bearer token between backend and updater sidecar.
# Required — without it the updater rejects every mutating request (fail-closed).
# Generate with:  openssl rand -hex 32
# Rotation: generate a new value, update .env in both containers' environment,
# then `docker compose up -d nodeglow updater` to reload them together.
UPDATE_SIDECAR_TOKEN=changeme-generate-with-openssl-rand-hex-32

# ── Backups (updater sidecar) ────────────────────────────────────────────────
# Scheduled Postgres dumps into the `backups` volume: "HH:MM" daily (UTC),
# "every 6h", or "off". Empty = daily at 02:30 UTC.
# BACKUP_SCHEDULE=02:30
# Dumps kept per kind (scheduled and pre-update are counted separately).
# BACKUP_RETENTION=5
# The dumps never contain SECRET_KEY. Back the key up separately, see
# docs/OPERATIONS.md "The encryption key". Copy the backups off the host too.
#
# Database container to dump. Leave unset: it is resolved from the running
# compose project. Only needed if that fails, e.g. DB_CONTAINER=nodeglow-db-1
# DB_CONTAINER=
#
# Host directory this stack runs from. Leave unset: read from the compose
# labels of the running backend. Set it if an update refuses to run because
# /data would move (docs/OPERATIONS.md "Updater: host paths").
# HOST_PROJECT_DIR=/opt/nodeglow

# ── Network exposure ─────────────────────────────────────────────────────────
# Host address the UI (port 8000) binds to. 127.0.0.1 when a reverse proxy on
# the same host terminates TLS.
# UI_BIND=0.0.0.0
# Host address the syslog listeners (514/udp, 1514/tcp) bind to.
# SYSLOG_BIND=0.0.0.0
# Enable no-new-privileges for the backend container. Off by default because
# ping relies on a file capability; verify ICMP checks still work after
# enabling (see the comment in docker-compose.yml).
# NODEGLOW_NO_NEW_PRIVILEGES=true

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=text         # text | json (one JSON object per line)

# ── Enterprise edition ───────────────────────────────────────────────────────
# License key, or a path inside the container (e.g. /data/nodeglow-license.txt).
# Optional: admins can also install it under Settings → License.
# NODEGLOW_LICENSE=
# "1" runs the community edition even though ee/ is built in.
# NODEGLOW_DISABLE_EE=1

# ── Redis (optional — only for multi-process / HA setups) ────────────────────
# Leave unset for the default single-process deployment. When set, the rate
# limiter is shared across processes; scheduler leader election (only one
# process runs the scheduled jobs) additionally needs the enterprise HA
# feature and a license. docker-compose.yml does NOT pass this variable to the
# backend: add it in a docker-compose.override.yml (docs/OPERATIONS.md,
# "Advanced backend settings").
# REDIS_URL=redis://redis:6379/0

# ── Speedtest ────────────────────────────────────────────────────────────────
# Bundle the Ookla speedtest CLI into the backend image. Off by default: the
# binary is proprietary, and Ookla's licence restricts redistribution and
# commercial use, so anything you hand to a customer must not carry it.
# Set to 1 for your own installation if you want Ookla's accuracy; without it
# the integration uses the unmaintained speedtest-cli, whose ping figures are
# unreliable on some connections.
# BUNDLE_OOKLA=1
